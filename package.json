{
	"name": "the-go-stack",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.15.1",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env server.js",
		"launch": "node --env-file-if-exists=.env scripts/launch.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"auth:schema": "auth generate --config src/lib/server/auth/index.ts --output src/lib/server/db/auth-schema.ts --yes && biome check --write src/lib/server/db/auth-schema.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
		"db:seed": "node --env-file-if-exists=.env scripts/seed.js",
		"billing:worker": "node --env-file-if-exists=.env scripts/billing-worker.js"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.77.0",
		"@polar-sh/sdk": "1.3.3",
		"@shadcn-svelte/primitives": "^0.0.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"@types/pg": "8.23.1",
		"auth": "1.7.27",
		"better-auth": "1.7.27",
		"bits-ui": "^2.22.0",
		"cn": "^0.5.2",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.4",
		"embla-carousel-svelte": "^8.6.0",
		"layerchart": "^2.11.0",
		"mode-watcher": "^1.1.0",
		"nodemailer": "10.6.1",
		"paneforge": "^1.0.2",
		"pg": "8.23.1",
		"redis": "6.4.0",
		"shiki": "^4.6.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"zod": "^4.6.7"
	}
}
