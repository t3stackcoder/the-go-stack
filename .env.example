# What the app reads from its environment. Copy this file to .env, which is never committed, and
# give BETTER_AUTH_SECRET a value of your own. The rest matches compose.yaml as it stands, so with
# `docker compose up -d --wait` running, the copy works unchanged.
#
# Each variable is declared, with its rule, in src/env.ts, and the server refuses to start on a
# value that breaks the rule. `pnpm dev`, `pnpm build`, `pnpm preview` and `pnpm start` all read
# .env. A deployment sets real variables instead.

# The Postgres database the accounts are kept in. The user, password and database are the ones
# compose.yaml creates.
DATABASE_URL=postgres://team:team@127.0.0.1:5432/team_collaborator

# Signs session cookies and the links sent by email. At least 32 characters, different on every
# deployment, and never this one. To make one: openssl rand -base64 32
# Changing it signs everybody out and voids every link already sent.
BETTER_AUTH_SECRET=replace-me-with-32-random-characters-or-more

# Where email goes. This is Mailpit, which keeps everything and delivers nothing: read it at
# http://localhost:8025. A real server is smtp://user:password@host:587, or smtps:// for port 465.
SMTP_URL=smtp://127.0.0.1:1025

# Who the app's email is from. This is the default, so the line can be left out.
MAIL_FROM=Team Collaborator <no-reply@team-collaborator.localhost>

# The first administrator, for `pnpm db:seed` (scripts/seed.js). It makes an account at this
# address with this password and the admin role, or makes a verified account already there an
# administrator. The server itself never reads these. Give ADMIN_PASSWORD a value of your own, of
# at least 8 characters: the seed refuses this one.
ADMIN_EMAIL=admin@team-collaborator.localhost
ADMIN_PASSWORD=replace-me-with-a-password-of-your-own

# How many services compose.yaml defines. The health page under /admin draws that many rows while
# it waits for Docker to list them, and warns when Docker lists a different number. Update it when
# a service is added to compose.yaml or taken out. Left out, the page draws no rows while it waits.
SERVICE_COUNT=4

# Development only: the fake providers in compose.yaml. While this is set, "Continue with
# Google", GitHub and Facebook all go to it, and it signs in a fixed, invented person without
# showing a page. It must name this machine, and the server refuses to start if it does not.
# Leave it out to use the real providers below. The content security policy names it too, and
# that is written when the site is built: change this, and build again.
OAUTH_MOCK_URL=http://127.0.0.1:4000

# The real providers. Each needs both of its values, and is offered on the sign-in page only when
# it has them. They are ignored while OAUTH_MOCK_URL is set. The address to register with each
# provider is <the site's origin>/api/auth/callback/<google|github|facebook>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# The Redis server billing keeps its counters in. This is the one compose.yaml runs.
REDIS_URL=redis://127.0.0.1:6379

# Development only: the fake Polar, which `pnpm billing:worker` (and `pnpm launch`) starts at this
# address while it is set. Upgrading goes to its checkout page, which has a Pay button and takes no
# card, and its portal page can end a period or fail a payment on demand. It must name this
# machine, and the server refuses to start if it does not. Leave it out to use the real Polar
# below. The content security policy names it too, and that is written when the site is built:
# change this, and build again.
POLAR_MOCK_URL=http://127.0.0.1:4100

# The real Polar. All four values come from Polar's dashboard and are needed together: until all
# four are set no checkout can be started, and the first thing that tries says which are missing.
# They are ignored while POLAR_MOCK_URL is set. POLAR_SERVER is "sandbox" (the default) or
# "production": each has its own tokens. The address to register for webhooks is
# <the site's origin>/api/webhooks/polar, and the secret is the one Polar shows for it.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_METER_ID=
