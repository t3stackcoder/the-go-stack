{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		// The same mapping as "imports" in package.json, which TypeScript reads without this. It is
		// here for the shadcn-svelte CLI, which only accepts an import alias it finds in `paths`.
		"paths": { "#lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "docker", "vite.config.ts", "drizzle.config.ts", "server.js"]
}
